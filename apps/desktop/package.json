{
  "name": "botcf-desktop",
  "version": "3.0.0",
  "private": true,
  "description": "BotCF 本地控制台桌面版",
  "author": "botcf-local",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "icon": "node build/generate-icon.mjs",
    "dist": "node build/dist.mjs"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.botcf.console",
    "productName": "BotCF-Local",
    "electronVersion": "43.4.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist/server.bundle.cjs",
        "to": "server/server.bundle.cjs"
      },
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "BotCF-Local-v${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "BotCF-Local-v${version}-Setup.${ext}"
    }
  }
}
