{
  "name": "botcf-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.bundle.cjs",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "undici": "^6.21.0",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
